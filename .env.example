# 飞书开放平台应用凭据（不要提交真实 .env）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：机器人名字。启动时会自动从飞书获取，获取失败才用这个名字识别群里的 @。默认“运营助手”
FEISHU_BOT_NAME=运营助手

# 可选：单局行动超时，单位毫秒；0 代表关闭自动弃牌
TURN_TIMEOUT_MS=60000
# 超时前多少毫秒提醒；默认 10 秒
TURN_WARNING_MS=10000

# 可选：新桌默认筹码与盲注
STARTING_STACK=1000
SMALL_BLIND=5
BIG_BLIND=10

# 补充筹码口令延迟到账时间；期间撤回消息会取消领取
BAILOUT_DELAY_MS=10000

# 内部测试开关：true 时允许一名玩家单独开局；正式使用请保持 false
ALLOW_SOLO_GAME=false

# 谁是卧底每位玩家的描述时限；超时自动跳过，默认 60 秒
UNDERCOVER_SPEAK_TIMEOUT_MS=60000

# 行动卡模式：private=自动私聊（稳妥），group=纯群聊点击后独享底牌
TURN_CARD_MODE=private

# 点击“开始下一局”后的准备时间，默认 3 秒
NEXT_HAND_DELAY_MS=3000

# 可选：牌桌状态恢复文件；默认使用项目 data/tables.json
TABLES_FILE=./data/tables.json

# 每日称号只发送到这个大群；留空则关闭。每天北京时间 09:00 发布昨日称号
DAILY_TITLE_CHAT_ID=
